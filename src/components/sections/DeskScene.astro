---
/**
 * Scena scrivania interattiva (sostituisce il placeholder 3D fino alla Fase 4).
 * ≥768px: illustrazioni posizionate in assoluto (unità %) in un contenitore
 * con aspect-ratio fisso. <768px: griglia 2x2 di tessere (requisito, non
 * ripiego). Le immagini sono PNG con alpha generati da scripts/prepara-scena.mjs
 * e convertiti in webp da <Image>. Burst e scintille sono SVG inline dietro
 * l'oggetto (i magenta sono prescritti dalla Fase 2.5, non stanno nei token).
 */
import { Image } from "astro:assets";
import computer from "../../assets/scene/computer.png";
import taccuino from "../../assets/scene/taccuino.png";
import telefono from "../../assets/scene/telefono.png";
import tabellino from "../../assets/scene/tabellino.png";
import tazza from "../../assets/scene/tazza.png";

/* Ordine dell'array = ordine DOM = ordine di tab richiesto. */
const oggetti = [
  {
    chiave: "computer",
    img: computer,
    href: "/#progetti",
    etichetta: "Progetti",
    aria: "Computer: vai ai progetti",
    profondita: 0.35,
  },
  {
    chiave: "taccuino",
    img: taccuino,
    href: "/come-lavoro",
    etichetta: "Come lavoro",
    aria: "Taccuino: come lavoro",
    profondita: 0.85,
  },
  {
    chiave: "telefono",
    img: telefono,
    href: "/contatti",
    etichetta: "Contatti",
    aria: "Telefono: contatti",
    profondita: 0.55,
  },
  {
    chiave: "tabellino",
    img: tabellino,
    href: "/progetti/caso-reale",
    etichetta: "Caso reale",
    aria: "Tabellino: il caso reale",
    profondita: 0.7,
  },
];

const larghezzaImg = (img: ImageMetadata) => Math.min(640, img.width);
---

<div class="desk">
  <!-- Scena (tablet e desktop) -->
  <div class="desk__scena">
    {
      oggetti.map(({ chiave, img, href, etichetta, aria, profondita }) => (
        <a
          class:list={["hotspot", `hotspot--${chiave}`]}
          href={href}
          aria-label={aria}
          data-depth={profondita}
        >
          <span class="hotspot__body">
            <svg class="fx fx--burst" viewBox="-100 -100 200 200" aria-hidden="true">
              <g class="fx__rot">
                {Array.from({ length: 10 }, (_, i) => (
                  <polygon points="-5,-34 5,-34 0,-92" transform={`rotate(${i * 36})`} />
                ))}
              </g>
            </svg>
            <svg class="fx fx--scintille" viewBox="0 0 100 100" aria-hidden="true">
              <path class="stella" d="M0 -11 L2.6 -2.6 L11 0 L2.6 2.6 L0 11 L-2.6 2.6 L-11 0 L-2.6 -2.6 Z" transform="translate(14 18) scale(1)" />
              <path class="stella" d="M0 -11 L2.6 -2.6 L11 0 L2.6 2.6 L0 11 L-2.6 2.6 L-11 0 L-2.6 -2.6 Z" transform="translate(88 26) scale(0.7)" />
              <path class="stella" d="M0 -11 L2.6 -2.6 L11 0 L2.6 2.6 L0 11 L-2.6 2.6 L-11 0 L-2.6 -2.6 Z" transform="translate(90 78) scale(0.55)" />
              <path class="stella" d="M0 -11 L2.6 -2.6 L11 0 L2.6 2.6 L0 11 L-2.6 2.6 L-11 0 L-2.6 -2.6 Z" transform="translate(10 84) scale(0.8)" />
            </svg>
            <Image
              class="hotspot__img"
              src={img}
              alt=""
              width={larghezzaImg(img)}
              format="webp"
              quality={80}
              loading="eager"
              fetchpriority="low"
            />
            <span class="hotspot__label">{etichetta}</span>
          </span>
        </a>
      ))
    }

    <button class="hotspot hotspot--tazza" type="button" aria-label="Tazza di caffè" data-depth="1">
      <span class="hotspot__body">
        <svg class="fx fx--vapore" viewBox="0 0 100 60" aria-hidden="true">
          <path d="M30 55 q-8 -12 0 -22 q8 -10 0 -20" />
          <path d="M52 58 q-9 -14 0 -26 q9 -12 0 -24" />
          <path d="M72 55 q-7 -11 0 -20 q7 -9 0 -18" />
        </svg>
        <Image
          class="hotspot__img"
          src={tazza}
          alt=""
          width={larghezzaImg(tazza)}
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="low"
        />
      </span>
    </button>

    <p class="desk__egg" role="status" hidden>// pausa caffè registrata nel log</p>
  </div>

  <!-- Tessere (mobile): gli stessi 4 oggetti, niente scena in miniatura -->
  <ul class="desk__tiles" role="list">
    {
      oggetti.map(({ chiave, img, href, etichetta, aria }) => (
        <li>
          <a class="tile" href={href} aria-label={aria}>
            <Image
              class="tile__img"
              src={img}
              alt=""
              width={larghezzaImg(img)}
              format="webp"
              quality={80}
              loading="eager"
              fetchpriority="low"
            />
            <span class="tile__label">{etichetta}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .desk {
    /* Colori del burst prescritti dalla Fase 2.5 (fuori token, solo qui) */
    --burst-1: #f01a7a;
    --burst-2: #ff4da6;
    --scintilla: #ffffff;
    width: 100%;
  }

  /* ---------- Scena (>=768px) ---------- */
  .desk__scena {
    display: none;
  }

  @media (min-width: 768px) {
    .desk__scena {
      position: relative;
      display: block;
      aspect-ratio: 5 / 4;
      width: min(100%, 620px);
      margin-inline: auto;
      margin-bottom: 2rem;
    }

  }

  .hotspot {
    position: absolute;
    display: block;
    border: 0;
    padding: 0;
    background: none;
    text-decoration: none;
    cursor: pointer;
  }

  /* Posizioni in % del contenitore, calcolate sui rapporti reali delle
     immagini rifilate. L'ordine DOM (= tab) resta computer, taccuino,
     telefono, tabellino, tazza indipendentemente dalla posizione. */
  .hotspot--computer { left: 7%; top: 1%; width: 46%; }
  .hotspot--telefono { left: 66%; top: 5%; width: 26%; }
  .hotspot--tabellino { left: 69%; top: 45%; width: 20%; }
  .hotspot--taccuino { left: 1%; top: 63%; width: 24%; }
  .hotspot--tazza { left: 47%; top: 66%; width: 19%; }

  /* L'hotspot attivo sale sopra tutto: le etichette vivono nello stacking
     context del proprio hotspot (creato dal transform del parallax), quindi
     è l'hotspot intero a dover vincere, non l'etichetta da sola */
  .hotspot:hover,
  .hotspot:focus-visible {
    z-index: 10;
  }

  .hotspot__body {
    position: relative;
    display: block;
    transition: transform 0.25s var(--ease-brand);
  }

  .hotspot__img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
  }

  /* Etichetta mono 12px in uno spazio vuoto vicino all'oggetto.
     Nascosta anche con visibility: opacity da sola non basta se un media
     query o un focus la riaccende dove non deve. */
  .hotspot__label {
    position: absolute;
    z-index: 2;
    top: 100%;
    left: 50%;
    translate: -50% 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.2; /* non ereditare 1.55: nei contenitori piccoli sborda */
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-ink);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s var(--ease-brand);
  }

  /* Il computer è largo e il suo centro cade sul taccuino: l'etichetta va
     nel varco libero tra taccuino e tazza (centro al 63% della larghezza) */
  .hotspot--computer .hotspot__label {
    left: 63%;
  }

  /* Il taccuino tocca il bordo sinistro: etichetta spostata verso destra,
     o il parallax la porta fuori dal contenitore */
  .hotspot--taccuino .hotspot__label {
    left: 62%;
    translate: -50% 0.125rem;
  }

  /* Solo su veri touch (niente hover E puntatore grosso): sempre visibili,
     o non si capisce che si clicca */
  @media (hover: none) and (pointer: coarse) {
    .hotspot__label {
      opacity: 1;
      visibility: visible;
    }
  }

  /* ---------- Burst e scintille (dietro l'oggetto, opacity 0) ---------- */
  .fx {
    position: absolute;
    z-index: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-brand);
  }

  .fx--burst {
    inset: -12%;
    width: 124%;
    height: 124%;
  }

  .fx__rot {
    transform-origin: center;
    animation: fx-rotazione 9s linear infinite;
    animation-play-state: paused;
  }

  .fx--burst polygon:nth-child(odd) { fill: var(--burst-1); }
  .fx--burst polygon:nth-child(even) { fill: var(--burst-2); }

  .fx--scintille {
    inset: -8%;
    width: 116%;
    height: 116%;
  }

  .stella {
    fill: var(--scintilla);
    transform-box: fill-box;
    transform-origin: center;
    animation: fx-scintilla 1.1s ease-in-out infinite;
    animation-play-state: paused;
  }

  .stella:nth-child(2) { animation-delay: 0.15s; }
  .stella:nth-child(3) { animation-delay: 0.3s; }
  .stella:nth-child(4) { animation-delay: 0.45s; }

  @keyframes fx-rotazione {
    to { transform: rotate(360deg); }
  }

  @keyframes fx-scintilla {
    0%, 100% { transform: scale(0.55); opacity: 0.4; }
    50% { transform: scale(1); opacity: 1; }
  }

  /* Vapore della tazza: animato da GSAP solo al click (easter egg) */
  .fx--vapore {
    top: -4%;
    left: 16%;
    width: 56%;
    height: 40%;
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 3.5;
    stroke-linecap: round;
    transition: none; /* l'opacità la guida GSAP, la transizione la sporcherebbe */
  }

  /* ---------- Stati hover / focus ---------- */
  @media (hover: hover) {
    .hotspot:hover .hotspot__body { transform: translateY(-6px); }
    .hotspot:hover .fx--burst,
    .hotspot:hover .fx--scintille { opacity: 1; }
    .hotspot:hover .fx__rot,
    .hotspot:hover .stella { animation-play-state: running; }
    .hotspot:hover .hotspot__label { opacity: 1; visibility: visible; }
  }

  .hotspot:focus-visible .hotspot__body { transform: translateY(-6px); }
  .hotspot:focus-visible .fx--burst,
  .hotspot:focus-visible .fx--scintille { opacity: 1; }
  .hotspot:focus-visible .fx__rot,
  .hotspot:focus-visible .stella { animation-play-state: running; }
  .hotspot:focus-visible .hotspot__label { opacity: 1; visibility: visible; }

  /* ---------- Easter egg ---------- */
  .desk__egg {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 3;
    margin: 0;
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-img);
    background: var(--color-giallo);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  /* ---------- Tessere (<768px) ---------- */
  .desk__tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    aspect-ratio: 1;
    padding: 0.75rem;
    border: var(--border-retro);
    border-radius: var(--radius-card);
    background: var(--color-cream-2);
    text-decoration: none;
    color: var(--color-ink);
  }

  .tile:active {
    background: var(--color-cream);
  }

  .tile__img {
    display: block;
    width: 62%;
    height: auto;
  }

  .tile__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
  }

  /* In fondo perché deve vincere sulla regola base .desk__tiles qui sopra */
  @media (min-width: 768px) {
    .desk__tiles {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const scena = document.querySelector<HTMLElement>(".desk__scena");

  if (scena) {
    // Parallax leggero al mouse: max 12px, lerp 0.06, velocità per profondità.
    // Solo con puntatore fine + hover e senza prefers-reduced-motion.
    const mm = gsap.matchMedia();
    mm.add(
      "(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)",
      () => {
        const setters = gsap.utils
          .toArray<HTMLElement>(".desk__scena .hotspot")
          .map((el) => ({
            sx: gsap.quickSetter(el, "x", "px"),
            sy: gsap.quickSetter(el, "y", "px"),
            profondita: Number(el.dataset.depth ?? 0.5),
            x: 0,
            y: 0,
          }));

        let tx = 0;
        let ty = 0;

        const onMove = (e: PointerEvent) => {
          const r = scena.getBoundingClientRect();
          tx = ((e.clientX - r.left) / r.width) * 2 - 1;
          ty = ((e.clientY - r.top) / r.height) * 2 - 1;
        };
        const onLeave = () => {
          tx = 0;
          ty = 0;
        };
        const tick = () => {
          for (const s of setters) {
            s.x += (tx * 12 * s.profondita - s.x) * 0.06;
            s.y += (ty * 12 * s.profondita - s.y) * 0.06;
            s.sx(s.x);
            s.sy(s.y);
          }
        };

        scena.addEventListener("pointermove", onMove);
        scena.addEventListener("pointerleave", onLeave);
        gsap.ticker.add(tick);

        return () => {
          scena.removeEventListener("pointermove", onMove);
          scena.removeEventListener("pointerleave", onLeave);
          gsap.ticker.remove(tick);
        };
      },
    );

    // Easter egg tazza: vapore + messaggio mono per 2s. Niente suoni, niente
    // blocchi. Con reduced-motion il messaggio appare comunque, senza vapore.
    const tazza = scena.querySelector<HTMLButtonElement>(".hotspot--tazza");
    const egg = scena.querySelector<HTMLElement>(".desk__egg");
    const vapore = scena.querySelectorAll(".fx--vapore path");
    let timerEgg: ReturnType<typeof setTimeout> | undefined;
    let tlVapore: gsap.core.Timeline | undefined;

    tazza?.addEventListener("click", () => {
      if (egg) {
        egg.hidden = false;
        clearTimeout(timerEgg);
        timerEgg = setTimeout(() => {
          egg.hidden = true;
        }, 2000);
      }
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        tlVapore?.kill();
        tlVapore = gsap
          .timeline({ onComplete: () => gsap.set(vapore, { clearProps: "all" }) })
          .fromTo(
            vapore,
            { autoAlpha: 0, y: 10 },
            { autoAlpha: 1, y: -14, duration: 0.9, stagger: 0.12, ease: "power1.out" },
          )
          .to(vapore, { autoAlpha: 0, y: -26, duration: 0.7, stagger: 0.1, ease: "power1.in" }, 0.9);
      }
    });
  }
</script>
