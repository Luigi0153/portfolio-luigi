---
/**
 * Griglia dei progetti.
 *
 * L'ordine cambia col percorso scelto nell'hero. Qui, a differenza del resto
 * dello switch, non basta il CSS: `order` sposta quello che si vede e non
 * quello che c'è, e le card sono link. Tabulazione e screen reader seguirebbero
 * l'ordine sorgente (WCAG 2.4.3 e 1.3.2), quindi le celle vengono riordinate
 * nel DOM da uno script inline, prima del paint.
 * Niente tre card uguali in fila: il caso reale prende la cella grande,
 * gli altri restano piccoli.
 */
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Card from "../ui/Card.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import Tag from "../ui/Tag.astro";

interface Props {
  id?: string;
  class?: string;
}

const { id = "progetti", class: className } = Astro.props;

const progetti = await getCollection("progetti");

// La cella grande va al progetto che viene primo nel percorso dev (l'ordine
// del markup). Esplicito e non il primo della collection: l'ordine in cui il
// loader legge i file non è garantito.
const featured = progetti.toSorted((a, b) => a.data.ordine_dev - b.data.ordine_dev)[0]?.id;
---

<section id={id} class:list={["section-pad", className]} aria-labelledby={`${id}-titolo`}>
  <div class="container-site">
    <SectionHeader id={`${id}-titolo`} title="Progetti">
      <p class="progetti__intro" data-only="dev">
        Il codice arriva per ultimo. Prima viene il problema vero.
      </p>
      <p class="progetti__intro" data-only="business">
        Ogni scelta qui sotto punta a vendere di più.
      </p>
    </SectionHeader>

    <ul class="progetti__griglia" role="list" data-griglia-progetti>
      {
        progetti.map(({ id: entryId, data }) => (
          <li
            class:list={[
              "progetti__cella",
              { "progetti__cella--grande": entryId === featured },
            ]}
            data-ord-dev={data.ordine_dev}
            data-ord-biz={data.ordine_business}
          >
            <div class="progetti__tilt" data-tilt>
              <Card href={`/progetti/${data.slug}`} padding="none" class="progetti__card">
                <Image
                  class="progetti__cover"
                  src={data.cover}
                  alt={data.coverAlt}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 1024px) 560px, (min-width: 768px) 45vw, 90vw"
                  format="webp"
                  quality={80}
                  loading="lazy"
                  transition:name={`cover-${data.slug}`}
                />

                <div class="progetti__corpo">
                  <p class="eyebrow text-ink-2 progetti__lente">{data.lente}</p>
                  <h3 class="progetti__titolo" transition:name={`titolo-${data.slug}`}>
                    {data.titolo}
                  </h3>
                  <p class="progetti__sommario">{data.sommario}</p>

                  <ul class="progetti__tags" role="list">
                    {data.tags.map((t) => (
                      <Tag as="li">{t}</Tag>
                    ))}
                  </ul>
                </div>
              </Card>
            </div>
          </li>
        ))
      }
    </ul>

    <script is:inline>
      // Riordino delle celle nel DOM, non con `order` CSS: così l'ordine di
      // tabulazione e quello degli screen reader coincidono con quello a
      // schermo in tutti e due i percorsi. Lo script è inline e sta subito
      // dopo la lista: gira mentre la pagina viene analizzata, prima del
      // paint, quindi non si vede nessun salto. Senza JavaScript resta
      // l'ordine del markup, che è quello del percorso "dev".
      (function () {
        function riordina() {
          var lista = document.querySelector("[data-griglia-progetti]");
          if (!lista) return;
          var chiave =
            document.documentElement.dataset.target === "business" ? "ordBiz" : "ordDev";
          var celle = Array.prototype.slice.call(lista.children);
          var volute = celle.slice().sort(function (a, b) {
            return Number(a.dataset[chiave]) - Number(b.dataset[chiave]);
          });
          // Se l'ordine è già quello giusto non si tocca niente: spostare un
          // nodo che contiene il focus lo farebbe perdere.
          var uguale = volute.every(function (cella, i) {
            return celle[i] === cella;
          });
          if (uguale) return;
          volute.forEach(function (cella) {
            lista.appendChild(cella);
          });
        }

        riordina();

        if (!window.__ordineProgetti) {
          window.__ordineProgetti = true;
          // Lo switch scrive data-target su <html> e non emette eventi:
          // l'osservatore è il modo di accorgersene senza toccare React.
          new MutationObserver(riordina).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["data-target"],
          });
          // Dopo lo swap delle View Transitions la lista è nuova e il target
          // viene riapplicato da Base.astro: si riordina lì, prima del paint.
          document.addEventListener("astro:after-swap", riordina);
        }
      })();
    </script>
  </div>
</section>

<style>
  .progetti__intro {
    color: var(--color-ink-2);
    max-width: 60ch;
  }

  .progetti__griglia {
    display: grid;
    gap: 1.25rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .progetti__griglia {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
      margin-top: 3.5rem;
    }

    .progetti__cella--grande {
      grid-column: 1 / -1;
    }
  }

  /* Niente `order` qui: l'ordine delle celle è quello del DOM, riordinato
     dallo script inline sopra. Vedi il commento in testa al componente. */

  /* La prospettiva sta sulla cella e non sulla griglia: un solo punto di fuga
     per tutta la griglia storcerebbe le card ai bordi. */
  .progetti__cella {
    perspective: 900px;
  }

  .progetti__tilt {
    height: 100%;
    transform-style: preserve-3d;
  }

  /* :global perché Card.astro non propaga i rest props e il suo elemento root
     non porta lo scope di questo componente: un selettore scopato non lo
     raggiungerebbe. L'antenato .progetti__cella tiene comunque la regola
     confinata a questa griglia. */
  .progetti__cella :global(.progetti__card) {
    display: flex;
    height: 100%;
    flex-direction: column;
  }

  .progetti__cover {
    display: block;
    width: 100%;
    height: auto;
    /* 3:2 come le copertine fotografiche. Le cover geometriche sono 4:3 e
       perdono solo una fascia vuota sopra e sotto. */
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-bottom: var(--border-retro);
  }

  .progetti__corpo {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.25rem;
  }

  .progetti__lente {
    /* la lente è un'etichetta di servizio, non un titolo */
    text-transform: uppercase;
  }

  .progetti__titolo {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .progetti__sommario {
    color: var(--color-ink-2);
    max-width: 52ch;
  }

  .progetti__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: auto 0 0;
    padding: 0.75rem 0 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .progetti__corpo {
      padding: 1.75rem;
    }

    /* Nella cella grande cover e testo stanno affiancati */
    .progetti__cella--grande :global(.progetti__card) {
      flex-direction: row;
      align-items: stretch;
      min-height: 340px;
    }

    /* flex-basis e non width: in riga un flex item con width in percentuale
       resta comunque dimensionato da flex-basis auto */
    .progetti__cella--grande .progetti__cover {
      flex: 0 0 46%;
      width: 46%;
      height: auto;
      align-self: stretch;
      aspect-ratio: auto;
      border-bottom: 0;
      border-right: var(--border-retro);
    }

    .progetti__cella--grande .progetti__corpo {
      justify-content: center;
      padding: 2.5rem;
    }

    .progetti__cella--grande .progetti__titolo {
      font-size: var(--text-h2);
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  /**
   * Tilt delle card: la card si inclina verso il puntatore, massimo 6 gradi.
   * Solo con puntatore fine e senza prefers-reduced-motion. L'inclinazione sta
   * su un wrapper e non sulla card, che ha già il suo translate all'hover:
   * due transform sullo stesso elemento si sovrascriverebbero.
   */
  const GRADI = 6;

  let mm: gsap.MatchMedia | undefined;

  function spegni() {
    mm?.revert();
    mm = undefined;
  }

  function avvia() {
    spegni();

    const carte = document.querySelectorAll<HTMLElement>("[data-tilt]");
    if (carte.length === 0) return;

    mm = gsap.matchMedia();

    mm.add("(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)", () => {
      const puliscono: (() => void)[] = [];

      for (const carta of carte) {
        const set = {
          rx: gsap.quickTo(carta, "rotationX", { duration: 0.4, ease: "power3.out" }),
          ry: gsap.quickTo(carta, "rotationY", { duration: 0.4, ease: "power3.out" }),
        };

        const muovi = (e: PointerEvent) => {
          const r = carta.getBoundingClientRect();
          const x = ((e.clientX - r.left) / r.width) * 2 - 1;
          const y = ((e.clientY - r.top) / r.height) * 2 - 1;
          set.ry(x * GRADI);
          set.rx(-y * GRADI);
        };

        const esci = () => {
          set.rx(0);
          set.ry(0);
        };

        carta.addEventListener("pointermove", muovi);
        carta.addEventListener("pointerleave", esci);
        puliscono.push(() => {
          carta.removeEventListener("pointermove", muovi);
          carta.removeEventListener("pointerleave", esci);
        });
      }

      return () => {
        for (const p of puliscono) p();
        gsap.set(carte, { clearProps: "transform" });
      };
    });
  }

  document.addEventListener("astro:page-load", avvia);
  document.addEventListener("astro:before-swap", spegni);
</script>
