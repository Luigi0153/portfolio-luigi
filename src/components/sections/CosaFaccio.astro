---
/**
 * "Cosa faccio per te": i servizi, solo nel percorso business.
 *
 * È il punto 4 di docs/AUDIT.md: un negoziante vedeva i progetti ma non
 * capiva cosa poteva chiedere. data-only="business" la toglie a schermo e
 * agli screen reader nel percorso dev e senza JavaScript (che vale dev).
 *
 * Apertura grande in Fraunces, righe numerate tra linee sottili ink. Accanto
 * a ogni numero c'è la L del marchio che si costruisce (LogoCresce): la barra
 * cresce di un segmento per riga, dall'alto in basso, e all'ultima riga arriva
 * il quarto di cerchio arancio. I pezzi non ancora arrivati sono un contorno
 * sottile. La figura ha sempre la stessa dimensione e posizione, con qualsiasi
 * numero di righe. In fondo un blocco ink con il bottone di contatto. Nessuna
 * animazione: la sezione non ne aveva e nel resto della home non ce ne sono
 * di simili.
 */
import Button from "../ui/Button.astro";
import LogoCresce from "../ui/LogoCresce.astro";

const SERVIZI = [
  {
    titolo: "Negozio online su Shopify",
    testo: "Dalla scelta del tema alle prime vendite.",
  },
  {
    titolo: "Landing page",
    testo: "Una pagina sola, pensata per un prodotto, un evento o una promozione.",
  },
  {
    titolo: "Siti su WordPress e altri strumenti",
    testo: "Scelgo lo strumento più adatto alla tua attività e al tuo budget.",
  },
  {
    titolo: "Logo e immagine del negozio",
    testo:
      "Colori, font e logo che si riconoscono, dal sito alle buste per le spedizioni.",
  },
] as const;
---

<section class="servizi" aria-labelledby="servizi-titolo" data-only="business">
  <div class="container-site">
    <p class="eyebrow text-ink-2">Cosa faccio per te</p>
    <h2 id="servizi-titolo" class="servizi__apertura">
      Creo negozi online e siti per le attività: su Shopify, su WordPress o con
      altri strumenti, in base a quello che ti serve.
    </h2>

    <ol class="servizi__lista" role="list">
      {
        SERVIZI.map(({ titolo, testo }, i) => (
          <li class="servizi__voce">
            <span class="servizi__numero eyebrow" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>

            <LogoCresce class="servizi__forma" riga={i} totale={SERVIZI.length} />

            <h3 class="servizi__titolo">{titolo}</h3>
            <p class="servizi__testo">{testo}</p>
          </li>
        ))
      }
    </ol>

    <div class="servizi__chiusura">
      <p class="servizi__frase">Il sito è tuo, e io resto al tuo fianco.</p>
      <Button variant="primary" size="lg" href="/contatti">Contattami</Button>
    </div>
  </div>
</section>

<style>
  /* Sopra c'è già il padding di fondo della griglia progetti. */
  .servizi {
    padding-bottom: var(--section-y);
  }

  .servizi__apertura {
    max-width: 24em;
    margin-top: 1rem;
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    line-height: 1.2;
  }

  /* Linee sottili ink tra le righe, lunghe quanto la lista. */
  .servizi__lista {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--color-ink);
  }

  /* Telefono: numero e forma sulla prima riga, poi titolo e testo. */
  .servizi__voce {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.75rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-ink);
  }

  .servizi__numero {
    color: var(--color-ink-2);
  }

  .servizi__voce :global(.servizi__forma) {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    width: 64px;
    height: 64px;
  }

  .servizi__titolo,
  .servizi__testo {
    grid-column: 1 / -1;
  }

  .servizi__titolo {
    margin: 0.25rem 0 0;
  }

  .servizi__testo {
    max-width: 44ch;
    margin: 0;
    color: var(--color-ink-2);
    font-size: var(--text-body-lg);
    line-height: 1.45;
  }

  @media (min-width: 768px) {
    .servizi__lista {
      margin-top: 3.5rem;
    }

    /* Da 768: numero, forma, titolo e testo affiancati su una riga. */
    .servizi__voce {
      grid-template-columns: 2.5rem 88px minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 1.5rem;
      row-gap: 0;
      padding-block: 1.75rem;
    }

    .servizi__voce :global(.servizi__forma) {
      grid-column: 2;
      justify-self: start;
      width: 88px;
      height: 88px;
    }

    .servizi__titolo {
      grid-column: 3;
      grid-row: 1;
      margin: 0;
    }

    .servizi__testo {
      grid-column: 4;
      grid-row: 1;
    }
  }

  /* Blocco di chiusura: pieno ink, testo cream, bottone arancio. */
  .servizi__chiusura {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding: 2rem 1.5rem;
    border-radius: var(--radius-card);
    background-color: var(--color-ink);
    color: var(--color-cream);
  }

  .servizi__frase {
    margin: 0;
    max-width: 18em;
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  @media (min-width: 768px) {
    .servizi__chiusura {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      margin-top: 3.5rem;
      padding: 3rem;
    }

    .servizi__frase {
      font-size: var(--text-h2);
    }
  }

  /* Sul fondo ink il riempimento ink dell'hover non si vedrebbe: il bottone
     si riempie di cream e il testo passa a ink. */
  .servizi__chiusura :global(.btn--primary)::before {
    background-color: var(--color-cream);
  }

  @media (hover: hover) {
    .servizi__chiusura :global(.btn--primary:not(:disabled):hover) {
      border-color: var(--color-cream);
      color: var(--color-ink);
    }
  }

  .servizi__chiusura :global(.btn--primary:not(:disabled):active) {
    border-color: var(--color-cream);
    color: var(--color-ink);
  }

  .servizi__chiusura :global(.btn:focus-visible) {
    outline-color: var(--color-cream);
  }
</style>
