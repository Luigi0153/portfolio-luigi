---
/**
 * Striscia "Loghi" della home: tutti i riquadri in un carosello e il link a
 * /loghi. Uguale nei due percorsi.
 */
import SectionHeader from "../ui/SectionHeader.astro";
import LoghiCarosello from "../ui/LoghiCarosello.astro";
import { getLoghi } from "../../loghi";

const loghi = await getLoghi();
---

<section class="striscia" aria-labelledby="loghi-striscia-titolo" data-fondo="loghi">
  <div class="container-site">
    <SectionHeader
      id="loghi-striscia-titolo"
      title="Loghi"
      intro="I marchi che ho disegnato per i miei progetti e per esercizio."
    />

    <LoghiCarosello loghi={loghi} class="striscia__carosello" />

    <p class="striscia__link">
      <a href="/loghi">Vedi tutti i loghi</a>
    </p>
  </div>
</section>

<style>
  /* Sopra c'è già il padding di fondo della griglia progetti. */
  .striscia {
    padding-bottom: var(--section-y);
  }

  .striscia :global(.striscia__carosello) {
    margin-top: 2.5rem;
  }

  .striscia__link {
    margin-top: 2rem;
  }

  .striscia__link a {
    display: inline-block;
    padding-block: 0.2rem;
    font-weight: 600;
  }
</style>
