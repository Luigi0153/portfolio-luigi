---
/**
 * Striscia "Loghi" della home: tutti i riquadri in un carosello e il link a
 * /loghi. Uguale nei due percorsi.
 */
import SectionHeader from "../ui/SectionHeader.astro";
import LoghiCarosello from "../ui/LoghiCarosello.astro";
import { getLoghi } from "../../loghi";

const loghi = await getLoghi();
---

<section class="striscia" aria-labelledby="loghi-striscia-titolo">
  <div class="container-site">
    <SectionHeader
      id="loghi-striscia-titolo"
      title="Loghi"
      intro="I marchi che ho disegnato per i miei progetti e per esercizio."
    />

    <LoghiCarosello loghi={loghi} class="striscia__carosello" />

    <p class="striscia__link">
      <a href="/loghi">Vedi tutti i loghi</a>
    </p>
  </div>
</section>

<style>
  /* Fondo ink a tutta larghezza. Sopra c'è il padding di fondo della sezione
     precedente; sotto lo stacco dall'invito lo dà il margine. */
  .striscia {
    --shadow-hard: 4px 4px 0 var(--color-cream);
    --shadow-hard-sm: 2px 2px 0 var(--color-cream);

    margin-bottom: var(--section-y);
    padding-block: var(--section-y);
    background-color: var(--color-ink);
    color: var(--color-cream);
    /* Barra di scorrimento del carosello quando è fermo (movimento ridotto,
       senza JavaScript): cream-2 su ink. */
    scrollbar-color: var(--color-cream-2) transparent;
  }

  .striscia :global(.section-header__intro),
  .striscia :global(.logo__nota) {
    color: var(--color-cream-2);
  }

  /* Dentro le card il testo resta ink su cream-2: cambiano solo il bordo e
     l'anello del focus, che in ink sparirebbero sul fondo. */
  .striscia :global(.card) {
    border-color: var(--color-cream);
  }

  .striscia :global(:focus-visible),
  .striscia :global(.card:focus-visible) {
    outline-color: var(--color-cream);
  }

  .striscia :global(.carosello__vista) {
    scrollbar-color: var(--color-cream-2) transparent;
  }

  .striscia :global(.striscia__carosello) {
    margin-top: 2.5rem;
  }

  .striscia__link {
    margin-top: 2rem;
  }

  .striscia__link a {
    display: inline-block;
    padding-block: 0.2rem;
    font-weight: 600;
  }

  /* L'arancio all'hover su ink fa 3,4:1, sotto il 4,5 del testo: il link resta
     cream e cambia il colore della sottolineatura. */
  .striscia__link a:hover {
    color: var(--color-cream);
    text-decoration-color: var(--color-cream);
  }
</style>
