---
/**
 * Button: primary (arancio), secondary (outline ink), ghost (solo testo).
 * Con `href` diventa un link. `state` forza uno stato visivo: serve solo alla styleguide.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  href?: string;
  disabled?: boolean;
  state?: "hover" | "focus" | "active";
  class?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  disabled = false,
  state,
  class: className,
  ...rest
} = Astro.props;

const isLink = Boolean(href) && !disabled;
const Tag = isLink ? "a" : "button";
---

<Tag
  class:list={["btn", `btn--${variant}`, `btn--${size}`, className]}
  href={isLink ? href : undefined}
  type={isLink ? undefined : type}
  disabled={!isLink && disabled ? true : undefined}
  aria-disabled={disabled ? "true" : undefined}
  data-state={state}
  {...rest}
>
  <span class="btn__label"><slot /></span>
</Tag>

<style>
  /*
    Hover = riempimento che scorre da sinistra (::before, solo transform scaleX).
    Niente ombra dura, niente traslazioni: forma, dimensioni e posizione non cambiano mai.
  */
  .btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.625rem 1.375rem;
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    transition:
      color 0.25s var(--ease-brand),
      border-color 0.25s var(--ease-brand);
  }

  .btn::before {
    content: "";
    position: absolute;
    inset: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease-brand);
  }

  .btn__label {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn--lg {
    min-height: 52px;
    padding: 0.875rem 1.75rem;
    font-size: 1.125rem;
  }

  /* Primary: base arancio, riempimento ink */
  .btn--primary {
    background-color: var(--color-arancio);
    border-color: var(--color-arancio);
    color: var(--color-cream);
  }

  .btn--primary::before {
    background-color: var(--color-ink);
  }

  /* Secondary: outline ink, riempimento ink */
  .btn--secondary {
    background-color: transparent;
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .btn--secondary::before {
    background-color: var(--color-ink);
  }

  /* Ghost: solo testo, riempimento cream-2 (il testo resta ink) */
  .btn--ghost {
    background-color: transparent;
    color: var(--color-ink);
    padding-inline: 0.75rem;
  }

  .btn--ghost::before {
    background-color: var(--color-cream-2);
  }

  /* Hover solo su dispositivi con hover reale: su touch il fill non resta attaccato dopo il tap */
  @media (hover: hover) {
    .btn:not(:disabled):hover::before {
      transform: scaleX(1);
    }

    .btn--primary:not(:disabled):hover {
      border-color: var(--color-ink);
    }

    .btn--secondary:not(:disabled):hover {
      color: var(--color-cream);
    }
  }

  /* Active: riempimento pieno immediato, nessun rimbalzo */
  .btn:not(:disabled):active {
    transition-duration: 0s;
  }

  .btn:not(:disabled):active::before,
  .btn[data-state="hover"]::before,
  .btn[data-state="active"]::before {
    transform: scaleX(1);
  }

  .btn:not(:disabled):active::before {
    /* translateZ(0) rende il valore diverso da quello dell'hover: cancella
       la transizione in corso, così il riempimento scatta subito a scaleX(1) */
    transform: scaleX(1) translateZ(0);
    transition-duration: 0s;
  }

  .btn--primary:not(:disabled):active,
  .btn--primary[data-state="hover"],
  .btn--primary[data-state="active"] {
    border-color: var(--color-ink);
  }

  .btn--secondary:not(:disabled):active,
  .btn--secondary[data-state="hover"],
  .btn--secondary[data-state="active"] {
    color: var(--color-cream);
  }

  /* Focus: solo :focus-visible, outline simmetrico su tutto il perimetro */
  .btn:focus-visible,
  .btn[data-state="focus"] {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .btn:disabled,
  .btn[aria-disabled="true"] {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* Niente scorrimento con reduced motion: cambio colore istantaneo */
  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn::before {
      transition: none;
    }
  }
</style>
