---
/**
 * Tag mono: etichette tech, categorie.
 * tone: ink (default, solo bordo), cream (fondo cream-2: chip di codice).
 */
interface Props {
  tone?: "ink" | "cream";
  as?: "span" | "li";
  class?: string;
}

const { tone = "ink", as: Tag = "span", class: className } = Astro.props;
---

<Tag class:list={["tag", `tag--${tone}`, className]}>
  <slot />
</Tag>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 28px;
    padding: 0.25rem 0.7rem;
    border: 1.5px solid var(--color-ink);
    border-radius: var(--radius-pill);
    background-color: transparent;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Chip di codice: fondo pieno, testo e bordo restano ink */
  .tag--cream {
    background-color: var(--color-cream-2);
  }
</style>
