---
/**
 * Conversione del sito mese per mese, SVG inline (nessuna libreria di grafici).
 * I valori sono quelli di docs/content/caso-reale.md: giugno-settembre 2026.
 * I numeri sono anche testo leggibile, non solo forme: lo screen reader legge
 * la tabella nel figcaption, non l'SVG (aria-hidden).
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// `valore` serve alla scala, `testo` è quello che si legge (virgola italiana).
const mesi = [
  { mese: "Giugno", valore: 0.19, testo: "0,19%" },
  { mese: "Luglio", valore: 0.35, testo: "0,35%" },
  { mese: "Agosto", valore: 0.36, testo: "0,36%" },
  { mese: "Settembre", valore: 0.5, testo: "0,50%" },
];

// Geometria: viewBox fisso, larghezza fluida. La scala parte da 0 e arriva a
// 0,6% (il massimo reale è 0,50%) per lasciare aria ai numeri sopra le barre.
const MAX = 0.6;
const BASE = 232; // y della linea di base
const ALTEZZA_UTILE = 168;
const LARGHEZZA_BARRA = 62;
const PASSO = 92;
const X0 = 34;

const barre = mesi.map((m, i) => {
  const altezza = (m.valore / MAX) * ALTEZZA_UTILE;
  return {
    ...m,
    x: X0 + i * PASSO,
    y: BASE - altezza,
    altezza,
    // l'ultimo mese è quello che porta la decisione: unico arancio
    colore: i === mesi.length - 1 ? "var(--color-arancio)" : "var(--color-ink)",
  };
});
---

<figure class:list={["ramp", className]}>
  <svg
    class="ramp__svg"
    viewBox="0 0 400 268"
    aria-hidden="true"
    data-ramp
  >
    {
      barre.map((b) => (
        <g>
          <rect
            class="ramp__barra"
            x={b.x}
            y={b.y}
            width={LARGHEZZA_BARRA}
            height={b.altezza}
            fill={b.colore}
            style={`--altezza: ${b.altezza}px; --base: ${BASE}px`}
          />
          <text class="ramp__valore" x={b.x + LARGHEZZA_BARRA / 2} y={b.y - 12}>
            {b.testo}
          </text>
          <text class="ramp__mese" x={b.x + LARGHEZZA_BARRA / 2} y={BASE + 26}>
            {b.mese}
          </text>
        </g>
      ))
    }
    <line class="ramp__base" x1="20" y1={BASE} x2="380" y2={BASE} />
  </svg>

  <figcaption class="ramp__caption">
    Conversione del sito, mese per mese: giugno 0,19%, luglio 0,35%, agosto
    0,36%, settembre 0,50%. Sono acquisti ogni 100 visite.
  </figcaption>
</figure>

<style>
  .ramp {
    margin: 0;
  }

  /* Il viewBox è 400 di larghezza: lasciando crescere l'SVG oltre questo, i
     numeri e le barre si ingigantiscono insieme al contenitore. */
  .ramp__svg {
    display: block;
    width: 100%;
    max-width: 460px;
    height: auto;
  }

  .ramp__barra {
    stroke: var(--color-ink);
    stroke-width: 2.5;
    /* il grow parte dalla base, non dal centro */
    transform-box: fill-box;
    transform-origin: center bottom;
  }

  .ramp__valore,
  .ramp__mese {
    text-anchor: middle;
    fill: var(--color-ink);
  }

  .ramp__valore {
    font-family: var(--font-display);
    font-variation-settings: var(--display-axes);
    /* "0,50%" è più largo di "31": a 30px due numeri vicini si toccano */
    font-size: 22px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .ramp__mese {
    font-family: var(--font-mono);
    /* i nomi interi stanno in 92px di passo solo a questo corpo */
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ramp__base {
    stroke: var(--color-ink);
    stroke-width: 2.5;
  }

  .ramp__caption {
    margin-top: 0.75rem;
    max-width: 52ch;
    font-size: 0.9375rem;
    color: var(--color-ink-2);
  }
</style>
