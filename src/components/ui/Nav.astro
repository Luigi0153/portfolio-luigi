---
/**
 * Nav: pillola flottante sticky, marchio SVG + 3 voci + "Scrivimi".
 * "Scrivimi" è l'unico accesso ai contatti e sta in pillola a ogni larghezza:
 * non c'è un menu a parte, le voci stanno tutte in riga.
 *
 * La voce attiva è una pillola ink che scorre da una voce all'altra:
 * un solo elemento (.site-nav__thumb) mosso da JS, perché tra elementi
 * diversi il CSS da solo non può interpolare. Il testo attivo passa a cream
 * con un ritardo pari alla corsa del thumb, così non resta cream su cream-2
 * mentre il riempimento è ancora per strada.
 *
 * L'header ha transition:persist per non sfarfallare tra una pagina e
 * l'altra: il DOM sopravvive allo swap, quindi aria-current NON si aggiorna
 * da solo e va ricalcolato dal client a ogni astro:page-load.
 * Il nome è fisso: senza, Astro usa un contatore che cambia da pagina a
 * pagina (home, caso reale e contatti avevano tre id diversi) e l'header
 * veniva sostituito invece che tenuto.
 */
import { LOGO_BARRA, LOGO_QUARTO, LOGO_VIEWBOX } from "../../logo";

const voci = [
  { href: "/#progetti", label: "Progetti", sezione: "progetti" },
  { href: "/come-lavoro", label: "Come lavoro" },
  { href: "/loghi", label: "Loghi" },
];

const pathname = Astro.url.pathname;
---

<header class="site-nav" transition:persist="site-nav">
  <div class="site-nav__pill">
    <a class="site-nav__logo" href="/" aria-label="Luigi Romano, torna alla home">
      <svg viewBox={LOGO_VIEWBOX} width="36" height="36" aria-hidden="true" focusable="false">
        <rect {...LOGO_BARRA} fill="var(--color-ink)" />
        <path class="site-nav__quarto" d={LOGO_QUARTO} fill="var(--color-arancio)" />
      </svg>
    </a>
    <span class="site-nav__sep" aria-hidden="true"></span>

    <nav class="site-nav__nav" aria-label="Principale">
      <span class="site-nav__thumb" aria-hidden="true"></span>
      <ul class="site-nav__list">
        {
          voci.map(({ href, label, sezione }) => {
            const paginaAttiva =
              !sezione && (pathname === href || pathname === `${href}/`);
            return (
              <li>
                <a
                  class="site-nav__link"
                  href={href}
                  data-sezione={sezione}
                  aria-current={paginaAttiva ? "page" : undefined}
                >
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <a
      class="site-nav__cta"
      href="/contatti"
      aria-current={pathname === "/contatti" || pathname === "/contatti/" ? "page" : undefined}
    >
      Scrivimi
    </a>
  </div>
</header>

<style>
  /*
    Il distacco dall'alto e dai lati è padding dell'header, non top della
    pillola: così lo stesso valore vale da fermi e da sticky, e la pillola non
    salta al primo scroll. L'header trasparente copre tutta la riga, quindi non
    deve intercettare i click fuori dalla pillola.

    Qui stanno anche le misure che cambiano con la larghezza, così pillola,
    voci e "Scrivimi" leggono tutte gli stessi valori. Gli spazi sono in
    clamp(): stretti sui telefoni piccoli, appena più larghi su quelli grandi,
    mai sparpagliati. Con quattro voci più il marchio la riga è piena già a
    360px, quindi sotto i 400px lo spazio scende in fretta: da 3,5px a 320 a
    7px a 390 (5vw - 12,5px). Il testo si ferma a 13px, e 0.3125rem + 2.5vw
    fa 14px a 360 e 13px a 320. "Scrivimi" tiene un po' più d'aria delle voci
    (--nav-pad-cta) e, sotto i 340px, dove non c'è posto, perde il bordo
    (--nav-bordo-cta) e resta una voce in grassetto.
  */
  .site-nav {
    --nav-gap: clamp(0.1875rem, 0.9vw, 0.25rem);
    --nav-pad-voce: clamp(0.21875rem, 5vw - 12.5px, 0.625rem);
    --nav-pad-cta: calc(var(--nav-pad-voce) + 1.5px);
    --nav-bordo-cta: 0px;
    --nav-testo-voce: clamp(0.8125rem, 0.3125rem + 2.5vw, 0.875rem);

    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: calc(var(--nav-top) + env(safe-area-inset-top, 0px));
    padding-inline: var(--nav-top);
    pointer-events: none;
  }

  @media (min-width: 340px) {
    .site-nav {
      --nav-bordo-cta: 2px;
    }
  }

  @media (min-width: 768px) {
    .site-nav {
      --nav-gap: 0.5rem;
      --nav-pad-voce: 0.875rem;
      --nav-pad-cta: 1.125rem;
      --nav-testo-voce: 0.9375rem;
    }
  }

  /*
    La pillola è larga quanto il suo contenuto e sta in mezzo, a ogni
    larghezza: mai a tutta riga. I 24px che la tengono staccata dai bordi sono
    il padding-inline dell'header (12px per lato, --nav-top), quindi qui il
    limite è il 100% di quello spazio già rientrato.
  */
  .site-nav__pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--nav-gap);
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
    padding: 5px;
    border: var(--border-retro);
    border-radius: var(--radius-pill);
    background: var(--color-cream-2);
  }

  @media (min-width: 768px) {
    .site-nav__pill {
      padding: 6px;
    }
  }

  /* Bersaglio da 44x44 con il marchio da 36 al centro. Il nome, per chi usa
     uno screen reader, sta nell'aria-label: l'SVG è solo decorazione. */
  .site-nav__logo {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
  }

  .site-nav__logo svg {
    display: block;
  }

  /*
    Il quarto di cerchio arancio ruota di 90 gradi e torna, in 450ms, al
    passaggio del mouse e col focus da tastiera. Gira attorno al centro del
    suo riquadro (63, 70 nel viewBox), così resta dentro il marchio. Al tocco
    lo avvia lo script su pointerdown con la classe is-gira, perché :active
    finisce al rilascio e taglierebbe l'animazione.
  */
  .site-nav__quarto {
    transform-box: view-box;
    transform-origin: 63px 70px;
  }

  @keyframes gira-quarto {
    50% {
      transform: rotate(90deg);
    }

    to {
      transform: rotate(0deg);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-nav__logo:focus-visible .site-nav__quarto,
    .site-nav__logo:global(.is-gira) .site-nav__quarto {
      animation: gira-quarto 450ms var(--ease-brand);
    }
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .site-nav__logo:hover .site-nav__quarto {
      animation: gira-quarto 450ms var(--ease-brand);
    }
  }

  /* Solo da 768: sotto, il marchio si stacca da solo dalle voci e la riga
     serve tutta a loro. */
  .site-nav__sep {
    display: none;
  }

  @media (min-width: 768px) {
    .site-nav__sep {
      display: block;
      flex: none;
      width: 2px;
      height: 1.25rem;
      border-radius: var(--radius-pill);
      background: var(--color-ink);
      opacity: 0.16;
    }
  }

  .site-nav__nav {
    position: relative;
    min-width: 0;
  }

  .site-nav__list {
    display: flex;
  }

  /* La pillola che scorre: sta sotto al testo, larghezza e posizione le
     scrive lo script. Senza --pronto non ha transizione, così al primo
     paint compare già al posto giusto invece di arrivarci scorrendo. */
  .site-nav__thumb {
    position: absolute;
    inset-block: 0;
    left: 0;
    z-index: 0;
    width: 0;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    opacity: 0;
  }

  .site-nav__thumb--pronto {
    transition:
      transform 0.3s var(--ease-brand),
      width 0.3s var(--ease-brand),
      opacity 0.2s var(--ease-brand);
  }

  .site-nav__thumb--attivo {
    opacity: 1;
  }

  .site-nav__link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--nav-pad-voce);
    font-size: var(--nav-testo-voce);
    font-weight: 500;
    /* le voci restano su una riga sola a qualsiasi larghezza */
    white-space: nowrap;
    text-decoration: none;
    transition: color 0.15s var(--ease-brand);
  }

  /* cream su ink = 17,9:1, ben sopra AA. Il ritardo tiene il testo scuro
     finché il thumb non è arrivato: senza, sarebbe cream su cream-2. */
  .site-nav__link[aria-current] {
    color: var(--color-cream);
    transition-delay: 0.18s;
  }

  /* Bordo ink e non arancio — l'arancio è della CTA primaria, una sola per
     schermata. Nella pagina dei contatti si riempie di ink, come una voce
     attiva. */
  .site-nav__cta {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--nav-pad-cta);
    border: var(--nav-bordo-cta) solid var(--color-ink);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    font-size: var(--nav-testo-voce);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color 0.25s var(--ease-brand),
      color 0.25s var(--ease-brand);
  }

  @media (min-width: 768px) {
    .site-nav__cta {
      margin-left: 0.25rem;
    }
  }

  .site-nav__cta[aria-current] {
    background: var(--color-ink);
    color: var(--color-cream);
  }

  @media (hover: hover) {
    .site-nav__cta:hover {
      background: var(--color-ink);
      color: var(--color-cream);
    }
  }

  .site-nav__logo:focus-visible,
  .site-nav__link:focus-visible,
  .site-nav__cta:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
    border-radius: var(--radius-pill);
  }

  /* Il global azzera le durate ma non i ritardi: qui il ritardo del colore
     esiste solo per accompagnare il thumb, che con reduce non si muove. */
  @media (prefers-reduced-motion: reduce) {
    .site-nav__thumb,
    .site-nav__link,
    .site-nav__link[aria-current] {
      transition: none;
      transition-delay: 0s;
    }
  }
</style>

<script>
  /*
    Tre cose, tutte rifatte a ogni navigazione perché l'header è persistito e
    il suo markup non viene rimpiazzato dallo swap:
    1. aria-current="page" della pagina corrente, anche su "Scrivimi"
       (server-side non basta più);
    2. scroll-spy delle sezioni presenti nella pagina (aria-current="true");
    3. posizione della pillola che evidenzia la voce attiva.
  */
  let osservatore: IntersectionObserver | undefined;
  let staccaResize: (() => void) | undefined;
  let primoGiro = true;

  function spegni() {
    osservatore?.disconnect();
    osservatore = undefined;
    staccaResize?.();
    staccaResize = undefined;
  }

  function avvia() {
    spegni();

    const nav = document.querySelector<HTMLElement>(".site-nav");
    if (!nav) return;

    const thumb = nav.querySelector<HTMLElement>(".site-nav__thumb");
    const cornice = nav.querySelector<HTMLElement>(".site-nav__nav");
    const links = [...nav.querySelectorAll<HTMLAnchorElement>(".site-nav__link")];
    const cta = nav.querySelector<HTMLAnchorElement>(".site-nav__cta");

    // 1. Pagina attiva: con transition:persist resta quella di partenza.
    // Le voci di sezione ripartono spente: se la sezione è in questa pagina
    // le riaccende l'osservatore qui sotto, altrimenti "Progetti" resterebbe
    // attiva uscendo dalla home.
    const qui = location.pathname.replace(/\/$/, "") || "/";
    for (const link of links) {
      if (link.dataset.sezione) {
        link.removeAttribute("aria-current");
        continue;
      }
      const suo = new URL(link.href).pathname.replace(/\/$/, "") || "/";
      if (suo === qui) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    }

    if (cta) {
      const suo = new URL(cta.href).pathname.replace(/\/$/, "") || "/";
      if (suo === qui) cta.setAttribute("aria-current", "page");
      else cta.removeAttribute("aria-current");
    }

    function posiziona() {
      if (!thumb || !cornice) return;
      const attivo = links.find((link) => link.hasAttribute("aria-current"));
      if (!attivo) {
        thumb.classList.remove("site-nav__thumb--attivo");
        return;
      }
      /*
        Rettangoli veri e non offsetWidth/offsetLeft: con padding e testo in
        clamp() le voci misurano frazioni di pixel, e gli offset* arrotondano
        all'intero — il riempimento resterebbe mezzo pixel fuori posto, che a
        320px si vede. La differenza tra i due left è la distanza dal bordo
        del nav, che è anche l'offsetParent del thumb.
      */
      const voce = attivo.getBoundingClientRect();
      thumb.style.width = `${voce.width}px`;
      thumb.style.transform = `translateX(${voce.left - cornice.getBoundingClientRect().left}px)`;
      thumb.classList.add("site-nav__thumb--attivo");
    }

    posiziona();

    // La transizione si accende dopo il primo posizionamento della sessione:
    // al caricamento la pillola deve essere già al posto giusto, non arrivarci.
    if (primoGiro) {
      primoGiro = false;
      requestAnimationFrame(() => {
        requestAnimationFrame(() => thumb?.classList.add("site-nav__thumb--pronto"));
      });
    }

    // Le larghezze cambiano quando arrivano i font: senza questo la pillola
    // resta della misura calcolata col fallback di sistema.
    document.fonts?.ready.then(posiziona);

    const suResize = () => posiziona();
    window.addEventListener("resize", suResize);
    staccaResize = () => window.removeEventListener("resize", suResize);

    // 2 + 3. Scroll-spy delle sezioni di questa pagina
    const coppie = links
      .map((link) => {
        const sezione = link.dataset.sezione
          ? document.getElementById(link.dataset.sezione)
          : null;
        return sezione ? { link, sezione } : null;
      })
      .filter((coppia) => coppia !== null);

    if (coppie.length > 0) {
      osservatore = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const coppia = coppie.find(({ sezione }) => sezione === entry.target);
            if (!coppia) continue;
            if (entry.isIntersecting) {
              coppia.link.setAttribute("aria-current", "true");
            } else {
              coppia.link.removeAttribute("aria-current");
            }
          }
          posiziona();
        },
        { rootMargin: "-30% 0px -60% 0px" },
      );

      coppie.forEach(({ sezione }) => osservatore?.observe(sezione));
    }
  }

  document.addEventListener("astro:page-load", avvia);
  document.addEventListener("astro:before-swap", spegni);

  // Marchio al tocco: l'animazione parte subito, su pointerdown, e la
  // navigazione verso la home avviene comunque al clic. Il mouse non passa da
  // qui: lo gestisce :hover. L'header è persistito, quindi un solo listener
  // sul documento basta per tutta la sessione.
  document.addEventListener("pointerdown", (evento) => {
    if (evento.pointerType === "mouse") return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const logo = (evento.target as Element).closest(".site-nav__logo");
    if (!logo) return;
    logo.classList.add("is-gira");
    logo.addEventListener("animationend", () => logo.classList.remove("is-gira"), { once: true });
  });
</script>
