---
/**
 * Dettaglio di un progetto.
 * Desktop: due colonne, la sinistra (titolo, lente, tags, cover) resta pinnata
 * da ScrollTrigger mentre scorrono i capitoli. Mobile: tutto in colonna, niente
 * pin. Capitoli, immagini e blocchi dati arrivano dal frontmatter e vengono
 * montati nell'ordine dichiarato (vedi content.config.ts).
 */
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import InvitoContatto from "../../components/sections/InvitoContatto.astro";
import Tag from "../../components/ui/Tag.astro";
import StatTile from "../../components/ui/StatTile.astro";
import RampChart from "../../components/ui/RampChart.astro";
import Funnel from "../../components/ui/Funnel.astro";
import BeforeAfter from "../../components/ui/BeforeAfter.astro";
import schedaPrima from "../../assets/progetti/scheda-prima.png";
import schedaDopo from "../../assets/progetti/scheda-dopo.png";

export async function getStaticPaths() {
  const progetti = await getCollection("progetti");
  return progetti.map((progetto) => ({
    params: { slug: progetto.data.slug },
    props: { progetto },
  }));
}

const { progetto } = Astro.props;
const { data } = progetto;

/* Figure con una versione mobile: la versione desktop va in un <source> da
   768px in su, e serve già ottimizzata qui (getImage) perché <source> non è
   un componente. Chiave: id del capitolo. */
const SIZES_FIGURA = "(min-width: 1024px) 760px, 90vw";
const figureDesktop = Object.fromEntries(
  await Promise.all(
    data.capitoli
      .filter((c) => c.figura?.mobile)
      .map(async (c) => [
        c.id,
        await getImage({ src: c.figura!.src, widths: [700, 1100, 1500], format: "webp", quality: 80 }),
      ]),
  ),
);
---

<Base
  title={data.titolo}
  description={data.sommario}
  ogType="article"
  ogImage={`/og/${data.slug}.png`}
>
  <article class="caso">
    <div class="container-site caso__griglia">
      <header class="caso__colonna">
        <div class="caso__intestazione" data-pin>
          <a class="caso__indietro eyebrow" href="/#progetti">Torna ai progetti</a>

          <p class="eyebrow text-ink-2 caso__lente">{data.lente}</p>

          <h1 class="caso__titolo" transition:name={`titolo-${data.slug}`}>
            {data.titolo}
          </h1>

          {data.nota && <p class="caso__nota">{data.nota}</p>}

          <ul class="caso__tags" role="list">
            {data.tags.map((t) => <Tag as="li">{t}</Tag>)}
          </ul>

          <Image
            class="caso__cover"
            src={data.cover}
            alt={data.coverAlt}
            widths={[400, 700]}
            sizes="(min-width: 1024px) 420px, 90vw"
            format="webp"
            quality={80}
            loading="eager"
            transition:name={`cover-${data.slug}`}
          />
        </div>
      </header>

      <div class="caso__corpo">
        {
          data.capitoli.map((capitolo) => (
            <section class="caso__sezione" aria-labelledby={`sez-${capitolo.id}`}>
              <h2 class="caso__sezione-titolo" id={`sez-${capitolo.id}`}>
                {capitolo.titolo}
              </h2>

              {capitolo.righe.map((riga) => (
                <p class="caso__riga">{riga}</p>
              ))}

              {capitolo.elenco &&
                (capitolo.elenco.numerato ? (
                  <ol class="caso__elenco caso__elenco--numerato">
                    {capitolo.elenco.voci.map((voce) => <li>{voce}</li>)}
                  </ol>
                ) : (
                  <ul class="caso__elenco">
                    {capitolo.elenco.voci.map((voce) => <li>{voce}</li>)}
                  </ul>
                ))}

              {capitolo.figura?.mobile ? (
                <figure class="caso__figura">
                  <picture>
                    <source
                      media="(min-width: 768px)"
                      type="image/webp"
                      srcset={figureDesktop[capitolo.id].srcSet.attribute}
                      sizes={SIZES_FIGURA}
                      width={capitolo.figura.src.width}
                      height={capitolo.figura.src.height}
                    />
                    <Image
                      class="caso__figura-img"
                      src={capitolo.figura.mobile}
                      alt={capitolo.figura.alt}
                      widths={[390, 780]}
                      sizes="90vw"
                      format="webp"
                      quality={80}
                      loading="lazy"
                    />
                  </picture>
                </figure>
              ) : capitolo.figura && (
                <figure class="caso__figura">
                  <Image
                    class="caso__figura-img"
                    src={capitolo.figura.src}
                    alt={capitolo.figura.alt}
                    widths={[700, 1100, 1500]}
                    sizes={SIZES_FIGURA}
                    format="webp"
                    quality={80}
                    loading="lazy"
                  />
                </figure>
              )}

              {capitolo.dati.map((blocco) => (
                <div class="caso__dato">
                  {blocco === "statistiche" && (
                    <div class="caso__stat">
                      <StatTile
                        value="+63%"
                        label="Ordini"
                        note="Da 19 a 31, giugno contro luglio."
                        conta
                      />
                      <StatTile
                        value="+86%"
                        label="Fatturato"
                        note="Stesso periodo, stesso store."
                        tone="arancio"
                        conta
                      />
                      <StatTile
                        value="94%"
                        label="Traffico da mobile"
                        note="Il desktop qui non esiste."
                        conta
                      />
                    </div>
                  )}
                  {blocco === "ramp" && <RampChart />}
                  {blocco === "funnel" && <Funnel />}
                  {blocco === "before-after" && (
                    <BeforeAfter
                      prima={schedaPrima}
                      primaAlt="Scheda prodotto mobile prima: testo fitto, gerarchia piatta, pulsante di acquisto in fondo alla pagina."
                      dopo={schedaDopo}
                      dopoAlt="Scheda prodotto mobile dopo: immagine grande, prezzo in evidenza, pulsante di acquisto sempre visibile in fondo allo schermo."
                      etichetta="Trascina per confrontare la scheda prodotto prima e dopo"
                    />
                  )}
                </div>
              ))}

              {capitolo.sottosezioni.map((sotto) => (
                <div class="caso__sotto">
                  <h3 class="caso__sotto-titolo">{sotto.titolo}</h3>
                  {sotto.righe.map((riga) => (
                    <p class="caso__riga">{riga}</p>
                  ))}
                </div>
              ))}

              {/* Mobile: una schermata alla volta, scorrendo in orizzontale.
                  Da 768 in su: tutte affiancate, una colonna per schermata.
                  Il contenitore è focalizzabile perché da tastiera si possa
                  scorrere. */}
              {capitolo.galleria.length > 0 && (
                <div
                  class="caso__galleria"
                  role="region"
                  aria-label={`Schermate del progetto, ${capitolo.galleria.length} immagini`}
                  tabindex="0"
                  style={`--schermate: ${capitolo.galleria.length}`}
                >
                  <ul class="caso__schermate" role="list">
                    {capitolo.galleria.map((schermata) => (
                      <li class="caso__schermata">
                        <figure>
                          <figcaption class="eyebrow caso__schermata-etichetta">
                            {schermata.etichetta}
                          </figcaption>
                          <Image
                            class="caso__schermata-img"
                            src={schermata.src}
                            alt={schermata.alt}
                            widths={[300, 450, 600, 780]}
                            sizes={`(min-width: 768px) ${Math.ceil(760 / capitolo.galleria.length)}px, 78vw`}
                            format="webp"
                            quality={80}
                            loading="lazy"
                          />
                        </figure>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          ))
        }
      </div>
    </div>
  </article>

  {/* Dopo "Cosa ho imparato" la pagina finiva nel footer: chi ha letto fin qui
      è il lettore più convinto che passa dal sito. */}
  <InvitoContatto />
</Base>

<style>
  .caso {
    padding-block: 2.5rem 5rem;
  }

  /* padding verticale per arrivare a 24px di altezza: a 13px il solo testo
     faceva un bersaglio da 18px, sotto il minimo di WCAG 2.2. Il margine
     negativo tiene l'allineamento ottico di prima. */
  .caso__indietro {
    display: inline-block;
    margin-block: -0.4rem;
    padding-block: 0.4rem;
    color: var(--color-ink-2);
    text-decoration: none;
  }

  .caso__indietro::before {
    content: "< ";
  }

  .caso__indietro:hover {
    color: var(--color-arancio);
  }

  .caso__lente {
    margin-top: 1.5rem;
  }

  .caso__titolo {
    margin-top: 0.5rem;
    font-size: var(--text-h2);
    text-wrap: balance;
  }

  .caso__nota {
    margin-top: 0.75rem;
    max-width: 44ch;
    color: var(--color-ink-2);
  }

  .caso__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .caso__cover {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 1.75rem;
    border: var(--border-retro);
    border-radius: var(--radius-img);
  }

  .caso__corpo {
    margin-top: 3rem;
  }

  .caso__sezione + .caso__sezione {
    margin-top: 3.5rem;
  }

  .caso__sezione-titolo {
    font-size: var(--text-h3);
    padding-bottom: 0.625rem;
    border-bottom: var(--border-retro);
  }

  .caso__riga {
    margin-top: 1rem;
    max-width: 62ch;
    font-size: var(--text-body-lg);
  }

  /* Stessa misura delle righe; il numero o il pallino sta fuori dal testo.
     list-style esplicito: il preflight di Tailwind lo azzera. */
  .caso__elenco {
    display: grid;
    gap: 0.625rem;
    margin: 1rem 0 0;
    max-width: 62ch;
    padding-left: 1.5rem;
    font-size: var(--text-body-lg);
    list-style: disc;
  }

  .caso__elenco--numerato {
    list-style: decimal;
  }

  .caso__elenco li::marker {
    color: var(--color-ink-2);
  }

  .caso__elenco--numerato li::marker {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .caso__dato {
    margin-top: 2rem;
  }

  .caso__stat {
    display: grid;
    gap: 1.5rem;
  }

  .caso__figura {
    margin: 2rem 0 0;
  }

  .caso__figura picture {
    display: block;
  }

  .caso__figura-img,
  .caso__schermata-img {
    display: block;
    width: 100%;
    height: auto;
    border: var(--border-retro);
    border-radius: var(--radius-img);
  }

  .caso__sotto {
    margin-top: 2rem;
  }

  /* Un gradino sotto il titolo del capitolo (che usa già --text-h3) */
  .caso__sotto-titolo {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .caso__sotto .caso__riga {
    margin-top: 0.5rem;
  }

  /* Mobile: le schermate scorrono in orizzontale, una alla volta. La striscia
     esce dal gutter fino ai bordi dello schermo, così la schermata seguente si
     vede spuntare a destra e si capisce che si può scorrere. */
  .caso__galleria {
    margin: 2.5rem calc(-1 * var(--gutter)) 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .caso__galleria::-webkit-scrollbar {
    display: none;
  }

  .caso__galleria:focus-visible {
    outline-offset: -3px;
  }

  /* max-content: la lista è larga quanto le schermate, così il padding di
     destra resta dentro l'area scorrevole e l'ultima schermata non tocca il
     bordo. Le schermate si misurano quindi in vw e non in percentuale. */
  .caso__schermate {
    display: flex;
    width: max-content;
    gap: 1rem;
    margin: 0;
    padding: 0.25rem var(--gutter) 0.5rem;
    list-style: none;
  }

  .caso__schermata {
    flex: 0 0 min(78vw, 320px);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .caso__schermata figure {
    margin: 0;
  }

  .caso__schermata-etichetta {
    margin-bottom: 0.625rem;
    color: var(--color-ink-2);
  }

  @media (min-width: 768px) {
    .caso__galleria {
      margin-inline: 0;
      overflow: visible;
      scroll-snap-type: none;
    }

    .caso__schermate {
      display: grid;
      width: auto;
      grid-template-columns: repeat(var(--schermate, 4), minmax(0, 1fr));
      align-items: start;
      padding: 0;
    }
  }

  @media (min-width: 640px) {
    .caso__stat {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .caso {
      padding-block: 3.5rem 7rem;
    }

    .caso__griglia {
      display: grid;
      grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }

    .caso__corpo {
      margin-top: 0;
      padding-top: 3.25rem; /* allinea la prima sezione al titolo */
    }

    .caso__sezione + .caso__sezione {
      margin-top: 5rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  /**
   * Pin della colonna sinistra mentre scorrono le sezioni. Solo da 1024px in su
   * (sotto, le due colonne sono una sola e non c'è niente da fissare) e mai con
   * prefers-reduced-motion. pinSpacing: false perché la colonna è più corta del
   * corpo: con lo spacing attivo resterebbe un buco alla fine.
   */
  let mm: gsap.MatchMedia | undefined;

  function spegni() {
    mm?.revert();
    mm = undefined;
  }

  function avvia() {
    spegni();

    const griglia = document.querySelector<HTMLElement>(".caso__griglia");
    const colonna = document.querySelector<HTMLElement>("[data-pin]");
    if (!griglia || !colonna) return;

    mm = gsap.matchMedia();

    mm.add("(min-width: 1024px) and (prefers-reduced-motion: no-preference)", () => {
      const trigger = ScrollTrigger.create({
        trigger: griglia,
        // la nav sticky è alta 60px: il pin si ferma sotto, non sotto di lei
        start: "top 84px",
        end: "bottom bottom",
        pin: colonna,
        pinSpacing: false,
      });

      return () => trigger.kill();
    });
  }

  document.addEventListener("astro:page-load", avvia);
  document.addEventListener("astro:before-swap", spegni);
</script>
