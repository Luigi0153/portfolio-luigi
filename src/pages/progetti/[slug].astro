---
/**
 * Dettaglio di un progetto.
 * Desktop: due colonne, la sinistra (titolo, lente, tags, cover) resta pinnata
 * da ScrollTrigger mentre scorrono i capitoli. Mobile: tutto in colonna, niente
 * pin. Capitoli, immagini e blocchi dati arrivano dal frontmatter e vengono
 * montati nell'ordine dichiarato (vedi content.config.ts).
 */
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import InvitoContatto from "../../components/sections/InvitoContatto.astro";
import Tag from "../../components/ui/Tag.astro";
import CasoElenco from "../../components/ui/CasoElenco.astro";
import CasoFigura from "../../components/ui/CasoFigura.astro";
import CasoDati from "../../components/ui/CasoDati.astro";
import CasoGalleria from "../../components/ui/CasoGalleria.astro";

export async function getStaticPaths() {
  const progetti = await getCollection("progetti");
  return progetti.map((progetto) => ({
    params: { slug: progetto.data.slug },
    props: { progetto },
  }));
}

const { progetto } = Astro.props;
const { data } = progetto;
---

<Base
  title={data.titolo}
  description={data.sommario}
  ogType="article"
  ogImage={`/og/${data.slug}.png`}
>
  <article class="caso">
    <div class="container-site caso__griglia">
      <header class="caso__colonna">
        <div class="caso__intestazione" data-pin>
          <a class="caso__indietro eyebrow" href="/#progetti">Torna ai progetti</a>

          <p class="eyebrow text-ink-2 caso__lente">{data.lente}</p>

          <h1 class="caso__titolo" transition:name={`titolo-${data.slug}`}>
            {data.titolo}
          </h1>

          {data.nota && <p class="caso__nota">{data.nota}</p>}

          {
            data.sintesi_business && (
              <p class="caso__sintesi" data-only="business">
                {data.sintesi_business.testo}{" "}
                <a href={`#sez-${data.sintesi_business.capitolo}`}>{data.sintesi_business.link}</a>
              </p>
            )
          }

          <ul class="caso__tags" role="list">
            {data.tags.map((t) => <Tag as="li">{t}</Tag>)}
          </ul>

          <Image
            class="caso__cover"
            src={data.cover}
            alt={data.coverAlt}
            widths={[400, 700]}
            sizes="(min-width: 1024px) 420px, 90vw"
            format="webp"
            quality={80}
            loading="eager"
            transition:name={`cover-${data.slug}`}
          />
        </div>
      </header>

      <div class="caso__corpo">
        {
          data.capitoli.map((capitolo) => (
            <section class="caso__sezione" aria-labelledby={`sez-${capitolo.id}`}>
              <h2 class="caso__sezione-titolo" id={`sez-${capitolo.id}`}>
                {capitolo.titolo}
              </h2>

              {capitolo.righe.map((riga) => (
                <p class="caso__riga">{riga}</p>
              ))}

              {capitolo.elenco && <CasoElenco {...capitolo.elenco} />}

              {capitolo.figura && <CasoFigura {...capitolo.figura} />}

              <CasoDati blocchi={capitolo.dati} />

              {capitolo.sottosezioni.map((sotto) => (
                <div class:list={["caso__sotto", { "caso__sotto--etichetta": sotto.etichetta }]}>
                  {sotto.etichetta && (
                    <p class="caso__sotto-etichetta">
                      <Tag>{sotto.etichetta}</Tag>
                    </p>
                  )}
                  <h3 class="caso__sotto-titolo">{sotto.titolo}</h3>
                  {sotto.righe.map((riga) => (
                    <p class="caso__riga">{riga}</p>
                  ))}
                  {sotto.elenco && <CasoElenco {...sotto.elenco} />}
                  <CasoDati blocchi={sotto.dati} />
                  {sotto.immagini.map((immagine) =>
                    "galleria" in immagine ? (
                      <CasoGalleria schermate={immagine.galleria} />
                    ) : (
                      <CasoFigura {...immagine} />
                    ),
                  )}
                </div>
              ))}

              {capitolo.galleria.length > 0 && <CasoGalleria schermate={capitolo.galleria} />}
            </section>
          ))
        }
      </div>
    </div>
  </article>

  {/* Dopo "Cosa ho imparato" la pagina finiva nel footer: chi ha letto fin qui
      è il lettore più convinto che passa dal sito. */}
  <InvitoContatto />
</Base>

<style>
  .caso {
    padding-block: 2.5rem 5rem;
  }

  /* padding verticale per arrivare a 24px di altezza: a 13px il solo testo
     faceva un bersaglio da 18px, sotto il minimo di WCAG 2.2. Il margine
     negativo tiene l'allineamento ottico di prima. */
  .caso__indietro {
    display: inline-block;
    margin-block: -0.4rem;
    padding-block: 0.4rem;
    color: var(--color-ink-2);
    text-decoration: none;
  }

  .caso__indietro::before {
    content: "< ";
  }

  .caso__indietro:hover {
    color: var(--color-arancio);
  }

  .caso__lente {
    margin-top: 1.5rem;
  }

  .caso__titolo {
    margin-top: 0.5rem;
    font-size: var(--text-h2);
    text-wrap: balance;
  }

  .caso__nota {
    margin-top: 0.75rem;
    max-width: 44ch;
    color: var(--color-ink-2);
  }

  /* Il risultato in breve, per il percorso business: in ink e non ink-2,
     perché i numeri sono la prima cosa che questo lettore cerca. Solo sotto
     i 1024: da lì le colonne sono due e le tessere del Contesto, con gli
     stessi numeri, stanno subito accanto. display:none la toglie anche agli
     screen reader. */
  .caso__sintesi {
    margin-top: 0.75rem;
    max-width: 44ch;
    color: var(--color-ink);
    font-size: var(--text-body-lg);
  }

  @media (min-width: 1024px) {
    .caso__sintesi {
      display: none;
    }
  }

  .caso__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .caso__cover {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 1.75rem;
    border: var(--border-retro);
    border-radius: var(--radius-img);
  }

  .caso__corpo {
    margin-top: 3rem;
  }

  .caso__sezione + .caso__sezione {
    margin-top: 3.5rem;
  }

  .caso__sezione-titolo {
    font-size: var(--text-h3);
    padding-bottom: 0.625rem;
    border-bottom: var(--border-retro);
  }

  .caso__riga {
    margin-top: 1rem;
    max-width: 62ch;
    font-size: var(--text-body-lg);
  }

  .caso__sotto {
    margin-top: 2rem;
  }

  /* Le parti con etichetta (per esempio le proposte) sono blocchi a sé:
     una linea sopra le separa da quello che viene prima. */
  .caso__sotto--etichetta {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: var(--border-retro);
  }

  .caso__sotto-etichetta {
    margin-bottom: 0.75rem;
  }

  /* Un gradino sotto il titolo del capitolo (che usa già --text-h3) */
  .caso__sotto-titolo {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .caso__sotto .caso__riga {
    margin-top: 0.5rem;
  }

  @media (min-width: 1024px) {
    .caso {
      padding-block: 3.5rem 7rem;
    }

    .caso__griglia {
      display: grid;
      grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }

    .caso__corpo {
      margin-top: 0;
      padding-top: 3.25rem; /* allinea la prima sezione al titolo */
    }

    .caso__sezione + .caso__sezione {
      margin-top: 5rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  /**
   * Pin della colonna sinistra mentre scorrono le sezioni. Solo da 1024px in su
   * (sotto, le due colonne sono una sola e non c'è niente da fissare) e mai con
   * prefers-reduced-motion. pinSpacing: false perché la colonna è più corta del
   * corpo: con lo spacing attivo resterebbe un buco alla fine.
   */
  let mm: gsap.MatchMedia | undefined;

  function spegni() {
    mm?.revert();
    mm = undefined;
  }

  function avvia() {
    spegni();

    const griglia = document.querySelector<HTMLElement>(".caso__griglia");
    const colonna = document.querySelector<HTMLElement>("[data-pin]");
    if (!griglia || !colonna) return;

    mm = gsap.matchMedia();

    mm.add("(min-width: 1024px) and (prefers-reduced-motion: no-preference)", () => {
      const trigger = ScrollTrigger.create({
        trigger: griglia,
        // la nav sticky è alta 60px: il pin si ferma sotto, non sotto di lei
        start: "top 84px",
        end: "bottom bottom",
        pin: colonna,
        pinSpacing: false,
      });

      return () => trigger.kill();
    });
  }

  document.addEventListener("astro:page-load", avvia);
  document.addEventListener("astro:before-swap", spegni);
</script>
