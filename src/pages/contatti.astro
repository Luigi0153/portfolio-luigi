---
/**
 * Contatti: due percorsi, scelti dallo stesso switch dell'hero.
 *
 * - "Cerchi uno sviluppatore": canali diretti e modulo corto (ContattiDev).
 * - "Vuoi vendere online": modulo a passi, una domanda per schermata
 *   (ContattiBusiness).
 * Senza una scelta salvata la pagina la chiede e non mostra nessun percorso;
 * senza JavaScript si vedono tutti e due e i moduli funzionano come moduli normali.
 */
import Base from "../layouts/Base.astro";
import TargetSwitch from "../components/ui/TargetSwitch";
import ContattiDev from "../components/sections/ContattiDev.astro";
import ContattiBusiness from "../components/sections/ContattiBusiness.astro";
import { FORM_ATTIVO } from "../dati-sito";

const descrizione = FORM_ATTIVO
  ? "Scrivimi: email, LinkedIn, GitHub o il modulo qui sotto, anche solo per dirti che non sono la persona giusta."
  : "Scrivimi: email, LinkedIn o GitHub, anche solo per dirti che non sono la persona giusta.";
---

<Base title="Contatti" description={descrizione} ogImage="/og/contatti.png">
  <section class="intro">
    <div class="intro__forme" aria-hidden="true">
      <span class="forma forma--quarto"></span>
      <span class="forma forma--cerchio"></span>
    </div>

    <div class="container-site intro__contenuto">
      <p class="eyebrow text-ink-2">Contatti</p>
      <h1 class="mt-4">Discutiamone insieme.</h1>
      <p class="intro__riga">
        Cerchi uno sviluppatore per il tuo team o per creare e gestire il tuo
        sito? Contattami.
      </p>
    </div>
  </section>

  {/* Stesso switch dell'hero, stessa scelta salvata (localStorage "target").
      Senza una scelta la pagina la chiede e non mostra nessun percorso. */}
  <section class="selettore" aria-label="Cosa cerchi">
    <div class="container-site">
      <p class="eyebrow text-ink-2">Cosa cerchi?</p>
      <div class="selettore__switch">
        <TargetSwitch client:load chiediScelta />
      </div>
      <p class="selettore__invito">
        Scegli una voce: il modulo cambia in base a quello che cerchi.
      </p>
    </div>
  </section>

  <div data-percorso="dev">
    <ContattiDev />
  </div>

  <div data-percorso="business">
    <ContattiBusiness />
  </div>
</Base>

<style>
  /* --- Intro --- */
  .intro {
    position: relative;
    overflow: hidden;
    padding-block: 3rem 1rem;
  }

  @media (min-width: 768px) {
    .intro {
      padding-block: 4.5rem 2rem;
    }
  }

  .intro__contenuto {
    position: relative;
    z-index: 1;
  }

  .intro__riga {
    max-width: 38ch;
    margin-top: 1.25rem;
    color: var(--color-ink-2);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
  }

  .intro__forme {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .forma {
    position: absolute;
  }

  /*
    Nessuna forma tocca il testo (scripts/test-forme.mjs). Il titolo occupa
    quasi tutta la riga, quindi le forme stanno sopra di lui o sotto la sua
    fine, mai alla sua altezza. Il quarto è ritagliato da un cerchio con il
    centro nell'angolo in alto a destra: è da lì che si misura la distanza.
  */
  .forma--quarto {
    top: -30px;
    right: -40px;
    width: 120px;
    height: 120px;
    border-radius: 0 0 0 100%;
    background: var(--color-arancio);
  }

  /* A 390 l'intro occupa tutta la larghezza: il cerchio finirebbe dietro al
     testo. Sotto i 768 resta solo il quarto di cerchio, che sta nell'angolo. */
  .forma--cerchio {
    display: none;
  }

  @media (min-width: 768px) {
    .forma--quarto {
      top: 0;
      right: 0;
      width: 130px;
      height: 130px;
    }

    /* Sotto la fine del titolo, a destra della riga di testo */
    .forma--cerchio {
      display: block;
      right: 12%;
      bottom: 0;
      width: 88px;
      height: 88px;
      border-radius: 50%;
      background: var(--color-ink);
    }
  }

  @media (min-width: 1024px) {
    .forma--quarto {
      width: 170px;
      height: 170px;
    }
  }

  /* --- Scelta del percorso --- */
  .selettore {
    padding-block: 1.5rem 0.5rem;
  }

  .selettore__switch {
    margin-top: 0.75rem;
  }

  /* Il messaggio c'è solo quando nessuna scelta è salvata: senza JavaScript
     (html senza data-target) non serve, perché i due percorsi sono in vista. */
  .selettore__invito {
    display: none;
    margin-top: 0.75rem;
    color: var(--color-ink-2);
  }

  html[data-target]:not([data-scelto]) .selettore__invito {
    display: block;
  }

  /*
    Quale percorso si vede. Con JavaScript acceso (lo script in Base.astro
    scrive sempre html[data-target]) si vede solo quello scelto, e nessuno se
    non c'è una scelta. Senza JavaScript non c'è nessun attributo: si vedono
    tutti e due, il selettore sparisce e i moduli funzionano come moduli normali.
  */
  html[data-target] [data-percorso] {
    display: none;
  }

  html[data-target][data-scelto="si"]:not([data-target="business"]) [data-percorso="dev"],
  html[data-target][data-scelto="si"][data-target="business"] [data-percorso="business"] {
    display: block;
  }

  /* Il contenuto del percorso sta vicino al selettore che lo ha scelto */
  [data-percorso] :global(.section-pad) {
    padding-top: 2.5rem;
  }

  html:not([data-target]) .selettore {
    display: none;
  }
</style>
