---
/**
 * Come lavoro: il processo in 4 step, lo stack, e il progetto n°5 (questo sito).
 *
 * Le due varianti di copy convivono nel markup (data-only) e si alternano via
 * CSS su html[data-target], come nell'hero: nessun re-render, nessun JS.
 */
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Button from "../components/ui/Button.astro";
import Tag from "../components/ui/Tag.astro";
import Card from "../components/ui/Card.astro";

const PASSI = [
  {
    nome: "Ci conosciamo",
    sintesi:
      "Ci sentiamo e mi racconti il tuo negozio: cosa vendi, a chi, cosa non ti convince.",
    righe: ["Insieme capiamo i pro e i contro delle tue idee."],
  },
  {
    nome: "Guardo i numeri",
    sintesi:
      "Poi guardo i dati del negozio, se ci sono: da dove arrivano i clienti, cosa comprano, dove si fermano.",
    righe: ["Così partiamo da quello che succede davvero."],
  },
  {
    nome: "Prototipo",
    sintesi: "Creo un prototipo e lo guardiamo insieme.",
    righe: [
      "È il momento in cui confrontiamo le idee su qualcosa di concreto, per arrivare al sito giusto.",
    ],
  },
  {
    nome: "Online",
    sintesi: "Costruisco il sito e lo metto online.",
    righe: ["Poi resto al tuo fianco per curarlo, aggiornarlo e farlo crescere."],
  },
] as const;

const STACK = [
  {
    gruppo: "E-commerce",
    voci: ["Shopify", "Liquid", "Theme customization", "Catalogo"],
  },
  {
    gruppo: "Front-end",
    voci: ["Astro", "Tailwind CSS", "React", "TypeScript"],
  },
  {
    gruppo: "Motion",
    voci: ["GSAP", "ScrollTrigger", "View Transitions"],
  },
  {
    gruppo: "Altro",
    voci: ["WordPress", "Vercel", "Playwright", "Figma"],
  },
] as const;
---

<Base
  title="Come lavoro"
  description="Come lavoro con i clienti, passo dopo passo, e gli strumenti che uso."
  ogImage="/og/come-lavoro.png"
>
  <section class="intro">
    <div class="intro__forme" aria-hidden="true">
      <span class="forma forma--cerchio"></span>
      <span class="forma forma--barra"></span>
    </div>

    <div class="container-site intro__contenuto">
      <p class="eyebrow text-ink-2">Il metodo</p>
      <h1 class="mt-4">Come lavoro</h1>
      <p class="intro__riga">
        Questi sono i passi che seguo, dall'idea al sito online.
      </p>
    </div>
  </section>

  <section class="section-pad processo" aria-labelledby="processo-titolo">
    <div class="container-site">
      <SectionHeader
        id="processo-titolo"
        label="Il processo"
        title="Come lavoriamo insieme"
      />

      <ol class="processo__lista" role="list">
        {
          PASSI.map(({ nome, sintesi, righe }, i) => (
            <li class="processo__passo" data-reveal>
              <Card class="processo__card" padding="lg">
                <p class="eyebrow processo__numero">
                  <span aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                  <span class="processo__nome">{nome}</span>
                </p>
                <h3 class="processo__sintesi">{sintesi}</h3>
                {righe.map((riga) => (
                  <p class="processo__riga">{riga}</p>
                ))}
              </Card>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section-pad stack" aria-labelledby="stack-titolo">
    <div class="container-site">
      <SectionHeader id="stack-titolo" label="Gli attrezzi" title="Lo stack">
        <p class="stack__intro" data-only="dev">
          Non uso tanti strumenti. Quelli che uso, li conosco bene.
        </p>
        <p class="stack__intro" data-only="business">
          Uso strumenti standard e diffusi. Il sito resta tuo, e io resto a
          disposizione.
        </p>
      </SectionHeader>

      <div class="stack__griglia">
        {
          STACK.map(({ gruppo, voci }) => (
            <div class="stack__gruppo" data-reveal>
              <h3 class="stack__gruppo-titolo">{gruppo}</h3>
              <ul class="stack__voci" role="list">
                {voci.map((voce) => (
                  <Tag as="li" tone="cream">
                    {voce}
                  </Tag>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-pad quinto" aria-labelledby="quinto-titolo">
    <div class="container-site">
      <SectionHeader
        id="quinto-titolo"
        label="Progetto n°5"
        title="Come ho costruito questo sito"
        intro="Anche questo portfolio è un progetto come gli altri quattro, fatto con lo stesso processo che ho appena descritto."
      />

      <div class="quinto__blocchi">
        <article class="quinto__blocco" data-reveal aria-labelledby="quinto-switch">
          <p class="eyebrow text-ink-2">La decisione</p>
          <h3 id="quinto-switch">Uno switch invece di due siti</h3>
          <p>
            Chi cerca uno sviluppatore e chi vuole vendere online cercano cose
            diverse nella stessa pagina. Il primo vuole capire come è fatto il
            sito, il secondo se funziona davvero. Fare due siti separati
            voleva dire scrivere tutto due volte, e poi mantenerlo due volte.
          </p>
          <p>
            Per questo lo switch che vedi nell'hero non nasconde niente:
            cambia i testi e l'ordine dei progetti. Le sezioni sono le stesse,
            l'HTML è lo stesso, cambia solo l'ordine delle priorità. La
            scelta resta salvata nel browser e vale su tutto il sito.
          </p>
          <p data-only="dev">
            Tecnicamente è un attributo sul tag <code>&lt;html&gt;</code> più
            qualche riga di CSS. La vista la decide il CSS, JavaScript serve
            solo a registrare il clic, quindi funziona anche prima che React
            finisca di caricarsi.
          </p>
          <p data-only="business">
            Il cambio è istantaneo, senza ricaricare la pagina, e la scelta
            resta anche quando torni.
          </p>
        </article>

        <article class="quinto__blocco" data-reveal aria-labelledby="quinto-stack">
          <p class="eyebrow text-ink-2">Il come</p>
          <h3 id="quinto-stack">Statico, e leggero per scelta</h3>
          <p>
            Il sito è quasi tutto pagine già pronte quando arrivano al
            browser, niente da costruire al volo. Uso React solo dove serve
            davvero muovere qualcosa, cioè lo switch e lo slider del
            prima/dopo. Il resto è HTML e CSS, e basta.
          </p>
          <p>
            Le animazioni si spengono da sole se il telefono chiede di
            ridurre il movimento. I font sono ospitati sul sito stesso, non
            scaricati da fuori, e le immagini vengono convertite in
            automatico in un formato più leggero.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-pad ia" aria-labelledby="ia-titolo" data-fondo="come-lavoro">
    <div class="container-site">
      <SectionHeader id="ia-titolo" title="Il mio processo creativo" />

      <div class="ia__testo" data-reveal>
        <p class="ia__apertura">
          Uso l'intelligenza artificiale in ogni progetto, come uno strumento
          di lavoro. Le idee, le scelte e il controllo finale restano miei.
        </p>
        <p>
          Mi aiuta a provare più strade in meno tempo: varianti di un logo,
          abbinamenti di colori e font, prime bozze dei testi. Scrivo il codice
          insieme a Claude Code e lo controllo con test automatici prima di
          pubblicarlo. Per i concept genero le foto con l'AI, e lo scrivo
          sempre.
        </p>
        <p>
          Così il lavoro va più veloce, e il tempo che risparmio lo dedico a
          rendere il negozio semplice da usare. Oggi saper usare bene questi
          strumenti fa parte del mestiere.
        </p>
      </div>

      <div class="quinto__cta" data-reveal>
        <Button variant="primary" size="lg" href="/contatti">
          <span data-only="dev">Parliamo di codice</span>
          <span data-only="business">Parliamo del tuo negozio</span>
        </Button>
        <Button variant="secondary" size="lg" href="/#progetti">Vedi i progetti</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  /* --- Intro --- */
  .intro {
    position: relative;
    overflow: hidden;
    padding-block: 3rem 1rem;
  }

  @media (min-width: 768px) {
    .intro {
      padding-block: 4.5rem 2rem;
    }
  }

  .intro__contenuto {
    position: relative;
    z-index: 1;
  }

  .intro__riga {
    max-width: 34ch;
    margin-top: 1.25rem;
    color: var(--color-ink-2);
    font-size: clamp(1.125rem, 2vw, 1.375rem);
  }

  .intro__forme {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .forma {
    position: absolute;
  }

  .forma--cerchio {
    top: -44px;
    right: -30px;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: var(--color-ink);
  }

  /* A 390 l'intro occupa tutta la larghezza: la barra finirebbe dietro al
     testo. Sotto i 768 resta solo il cerchio, che sta fuori dalla colonna. */
  .forma--barra {
    display: none;
  }

  @media (min-width: 768px) {
    .forma--cerchio {
      top: -50px;
      right: 8%;
      width: 180px;
      height: 180px;
    }

    .forma--barra {
      display: block;
      right: 4%;
      bottom: 10%;
      width: 240px;
      height: 26px;
      border-radius: var(--radius-pill);
      background: var(--color-arancio);
    }
  }

  /* --- Processo --- */
  .processo__lista {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
    counter-reset: passo;
  }

  @media (min-width: 768px) {
    .processo__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
      margin-top: 3.5rem;
    }
  }

  .processo__card {
    height: 100%;
  }

  /* Il numero in ink-2, non in arancio: a 13px su cream-2 l'arancio si ferma a
     4,24:1, sotto il 4,5 di AA. L'accento resta nel quadratino, che è
     decorativo e deve solo passare il 3:1 dei non-testo. */
  .processo__numero {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-ink-2);
  }

  .processo__numero::before {
    content: "";
    flex: none;
    width: 0.6em;
    height: 0.6em;
    border-radius: 2px;
    background: var(--color-arancio);
  }

  .processo__nome {
    color: var(--color-ink);
  }

  .processo__sintesi {
    margin-top: 0.75rem;
  }

  .processo__riga {
    margin-top: 0.75rem;
    color: var(--color-ink-2);
  }

  /* --- Stack --- */
  .stack {
    background: var(--color-cream-2);
    border-block: var(--border-retro);
  }

  .stack__intro {
    color: var(--color-ink-2);
    max-width: 60ch;
  }

  .stack__griglia {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .stack__griglia {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
      margin-top: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .stack__griglia {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .stack__gruppo-titolo {
    padding-bottom: 0.75rem;
    border-bottom: var(--border-retro);
  }

  .stack__voci {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  /* --- Progetto n°5 --- */
  .quinto__blocchi {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 1024px) {
    .quinto__blocchi {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem;
      margin-top: 3.5rem;
    }
  }

  .quinto__blocco h3 {
    margin-top: 0.5rem;
  }

  .quinto__blocco p + p,
  .quinto__blocco h3 + p {
    margin-top: 1rem;
  }

  .quinto__blocco p:not([class]) {
    color: var(--color-ink-2);
  }

  /* Chip di codice: testo ink su cream-2, contrasto 14,5:1. */
  .quinto__blocco code {
    padding: 0.15em 0.4em;
    border-radius: 4px;
    background: var(--color-cream-2);
    color: var(--color-ink);
    font-size: 0.9em;
    overflow-wrap: anywhere;
  }

  /* --- Il mio processo creativo --- */
  .ia {
    background: var(--color-cream-2);
    border-block: var(--border-retro);
  }

  .ia__testo {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .ia__testo {
      margin-top: 3.5rem;
    }
  }

  .ia__testo p {
    color: var(--color-ink-2);
  }

  .ia__apertura {
    color: var(--color-ink);
    font-size: var(--text-body-lg);
  }

  /* --- CTA --- */
  .quinto__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3.5rem;
  }
</style>

<script>
  // Entrate allo scroll: fade + y 24, stagger 80ms, come il resto del sito.
  // Con prefers-reduced-motion matchMedia non entra e resta tutto fermo e visibile.
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  let mm: gsap.MatchMedia | undefined;

  function spegni() {
    mm?.revert();
    mm = undefined;
  }

  function avvia() {
    spegni();
    if (!document.querySelector("[data-reveal]")) return;

    mm = gsap.matchMedia();

    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const gruppi = new Map<Element, HTMLElement[]>();

      gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
        const sezione = el.closest("section") ?? document.body;
        const lista = gruppi.get(sezione) ?? [];
        lista.push(el);
        gruppi.set(sezione, lista);
      });

      // Uno ScrollTrigger per sezione: gli elementi della stessa sezione
      // entrano in sequenza, non uno per uno appena sfiorano il bordo.
      for (const [sezione, elementi] of gruppi) {
        gsap.from(elementi, {
          autoAlpha: 0,
          y: 24,
          duration: 0.6,
          ease: "power3.out",
          stagger: 0.08,
          clearProps: "all",
          scrollTrigger: { trigger: sezione, start: "top 80%" },
        });
      }
    });
  }

  document.addEventListener("astro:page-load", avvia);
  document.addEventListener("astro:before-swap", spegni);
</script>
